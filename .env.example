# Copy to .env (git-ignored) and fill in. Used by `docker compose` and by local runs
# (spring-dotenv). Database and service URLs are set by docker-compose.yml.

# Security
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

# Google OAuth (sign in with Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Amadeus (flights, activities, AI grounding) - https://developers.amadeus.com
AMADEUS_API_KEY=
AMADEUS_API_SECRET=

# Gmail SMTP (password reset)
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# Supabase storage (avatars)
SUPABASE_SERVICE_KEY=

# AI service: the LLM key is used by atlas-ai_service, the shared secret by both
LLM_API_KEY=
AI_SERVICE_API_KEY=local-dev-key

# Local run without docker compose
DB_URL=jdbc:postgresql://localhost:5432/atlas
DB_USERNAME=atlas
DB_PASSWORD=atlas
